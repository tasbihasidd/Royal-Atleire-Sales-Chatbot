# =============================================================================
# Royal Atelier Chatbot — PRODUCTION
# Server pe is file ko `.env` naam se rakho (ya inhi values paste karo).
# Secrets: FAL_KEY / LANGSMITH_API_KEY apni asli values se replace karo.
# =============================================================================

FAL_KEY=fal-key

# fal.ai — single provider for chat, vision, and custom images
LLM_PROVIDER=fal
FAL_LLM_MODEL=google/gemini-2.5-flash
FAL_VISION_MODEL=google/gemini-2.5-flash
FAL_IMAGE_MODEL=fal-ai/bytedance/seedream/v5/lite/edit
FAL_IMAGE_T2I_MODEL=fal-ai/bytedance/seedream/v5/lite/text-to-image
FAL_TRYON_MODEL=bria/fibo-edit-1.5/virtual-try-on

# --- LangSmith (opt-in observability + per-session cost) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=api key
LANGSMITH_PROJECT=pr-drab-industrialization-73
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_HIDE_INPUTS=false
LANGCHAIN_HIDE_OUTPUTS=false
INCLUDE_COST_IN_RESPONSE=false

BACKEND_API_BASE_URL=https://royal-attire-api.devssh.xyz/api/v2/sales-agent
# BACKEND_API_TOKEN=

PORT=2006
BASE_URL=https://ai.turabees.com

# Host → published postgres (127.0.0.1:22006). Password must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://royal:royal@localhost:22006/royal_atelier

LOG_LEVEL=INFO
USE_MOCK_DATA=false

# Chatbot daily quotas — limits from RA GET /limits
CHATBOT_QUOTA_ENFORCE=true
CHATBOT_QUOTA_USE_BACKEND=true

# =============================================================================
# Security (prod)
# =============================================================================
APP_ENV=prod
ENABLE_DEV_ENDPOINTS=false
QUOTA_ADMIN_KEY=mrCwwGHxh8oMnox06M1rfK7JlfJxSnUHR27bObFKHno
# Required: FE must send header X-Api-Key with this value on /chat, image, try-on
CHATBOT_API_KEY=meH0ixRyCoHvLkEY534dGVdEOhvMHNg1eRKn-BleqYo
CORS_ORIGINS=https://www.turabees.com,https://turabees.com
REDIS_URL=redis://redis:6379/0
SESSION_COOKIE_NAME=royal_session
SESSION_REQUIRE_COOKIE_IN_PROD=false

# Docker compose DB — abhi DATABASE_URL ke saath match (royal).
# Strong password tab badlo jab DB recreate / migrate karo (dono jagah same).
POSTGRES_USER=royal
POSTGRES_PASSWORD=royal
POSTGRES_DB=royal_atelier

MAX_REQUEST_BODY_BYTES=1048576
MEMORY_CACHE_MAX_SESSIONS=500
