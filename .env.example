# =============================================================================
# Royal Atelier Chatbot — env template (copy to .env and fill secrets)
# =============================================================================

# --- LLM (chatbot-only secrets — NEVER share with FE) ---
LLM_PROVIDER=fal
FAL_KEY=
FAL_LLM_MODEL=google/gemini-2.5-flash
FAL_VISION_MODEL=google/gemini-2.5-flash
FAL_IMAGE_MODEL=fal-ai/bytedance/seedream/v5/lite/edit
FAL_IMAGE_T2I_MODEL=fal-ai/bytedance/seedream/v5/lite/text-to-image
FAL_TRYON_MODEL=bria/fibo-edit-1.5/virtual-try-on

# --- Turabees / RA backend (chatbot server-to-server) ---
BACKEND_API_BASE_URL=https://royal-attire-api.devssh.xyz/api/v2/sales-agent
BACKEND_API_TOKEN=

# --- App URL / DB ---
PORT=8015
BASE_URL=http://localhost:8015
DATABASE_URL=postgresql+asyncpg://royal:royal@localhost:22006/royal_atelier

LOG_LEVEL=INFO
USE_MOCK_DATA=false
# PKR_PER_GBP=350

# --- Quotas ---
CHATBOT_QUOTA_ENFORCE=true
CHATBOT_QUOTA_USE_BACKEND=true
# CHATBOT_AI_MESSAGES_PER_DAY=10
# CHATBOT_CUSTOM_IMAGES_PER_DAY=2

# --- Security ---
# local: APP_ENV=dev | live: APP_ENV=prod
APP_ENV=dev
ENABLE_DEV_ENDPOINTS=true
# Prod example:
# APP_ENV=prod
# ENABLE_DEV_ENDPOINTS=false
# CORS_ORIGINS=https://www.turabees.com,https://turabees.com
# QUOTA_ADMIN_KEY=generate-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8015
QUOTA_ADMIN_KEY=
# Protect /chat + image + try-on. Header: X-Api-Key. Required in prod; empty = open in dev.
CHATBOT_API_KEY=
SESSION_COOKIE_NAME=royal_session
SESSION_REQUIRE_COOKIE_IN_PROD=false
REDIS_URL=redis://localhost:6379/0
MAX_REQUEST_BODY_BYTES=1048576
MEMORY_CACHE_MAX_SESSIONS=500
POSTGRES_USER=royal
POSTGRES_PASSWORD=royal
POSTGRES_DB=royal_atelier

# --- LangSmith (optional, chatbot-only) ---
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=royal-atelier-sales-agent
