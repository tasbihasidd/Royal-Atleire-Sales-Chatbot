# LLM provider factory (openrouter | fireworks | deepseek | openai | groq | anthropic | none)
LLM_PROVIDER=openrouter
# Optional overrides — if empty, each provider class uses its own defaults / key.
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
FIREWORKS_API_KEY=
DEEPSEEK_API_KEY=

# LLM via OpenRouter (OpenAI-compatible). Used when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter model ids look like: anthropic/claude-opus-4.5, openai/gpt-4o, etc.
OPENAI_MODEL=minimax/minimax-m3
FABRIC_ANALYSIS_MODEL=minimax/minimax-m3
IMAGE_MODEL=openai/gpt-4o
OPENROUTER_HTTP_REFERER=http://localhost:8015
OPENROUTER_APP_TITLE=Royal Atelier Sales Agent

# Backend API (real-time product/inventory/handover)
BACKEND_API_BASE_URL=https://royal-attire-api.devssh.xyz/api/v2/sales-agent
BACKEND_API_TOKEN=
BASE_URL=http://localhost:8015

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://royal:royal@postgres:5432/royal_atelier

# Logging
LOG_LEVEL=INFO

# Mock Data Mode (set to true to use sample data instead of backend APIs)
# Useful for testing when backend is unavailable or incomplete
USE_MOCK_DATA=false

# Display FX for PK market (catalogue GBP → PKR). Unset → never invent a rate.
PKR_PER_GBP=350
