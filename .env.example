# LLM via fal.ai (single provider for chat, vision, and images)
LLM_PROVIDER=fal
FAL_KEY=
FAL_LLM_MODEL=google/gemini-2.5-flash
FAL_VISION_MODEL=google/gemini-2.5-flash
FAL_IMAGE_MODEL=fal-ai/bytedance/seedream/v5/lite/edit
FAL_IMAGE_T2I_MODEL=fal-ai/bytedance/seedream/v5/lite/text-to-image
# Virtual try-on (Bria FIBO-Edit 1.5) — only image_url + product_url on the API
FAL_TRYON_MODEL=bria/fibo-edit-1.5/virtual-try-on

# Previous providers (disabled)
# LLM_PROVIDER=openrouter
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=
# FIREWORKS_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=minimax/minimax-m3
# FABRIC_ANALYSIS_MODEL=minimax/minimax-m3
# IMAGE_MODEL=openai/gpt-4o
# OPENROUTER_HTTP_REFERER=http://localhost:8015
# OPENROUTER_APP_TITLE=Royal Atelier Sales Agent

# Backend API (real-time product/inventory/handover)
BACKEND_API_BASE_URL=https://royal-attire-api.devssh.xyz/api/v2/sales-agent
BACKEND_API_TOKEN=

# --- Local uvicorn (host) ---
# python -m uvicorn app.main:app --host 0.0.0.0 --port 8015 --reload
BASE_URL=http://localhost:8015
# Local uvicorn: only works if you temporarily publish postgres (not in compose by default).
# Prefer docker compose for DB, or set DATABASE_URL to an external Postgres.
# DATABASE_URL=postgresql+asyncpg://royal:royal@localhost:5432/royal_atelier
DATABASE_URL=postgresql+asyncpg://royal:royal@localhost:5432/royal_atelier

# --- Docker / live (docker compose up) ---
# compose overrides PORT=2006, BASE_URL=http://localhost:2006,
# and DATABASE_URL=...@postgres:5432 (container DNS). Do not put @postgres in .env for host runs.

# --- LangSmith (opt-in observability + per-session cost) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=royal-atelier-sales-agent
# LANGSMITH_ENDPOINT=
# LANGCHAIN_HIDE_INPUTS=false
# LANGCHAIN_HIDE_OUTPUTS=false
# INCLUDE_COST_IN_RESPONSE=false
# Session cost fallbacks only if api.fal.ai pricing/billing is unreachable
# LLM_COST_INPUT_PER_1M_USD=0.15
# LLM_COST_OUTPUT_PER_1M_USD=0.60
# FAL_IMAGE_COST_USD=0.04

# Logging
LOG_LEVEL=INFO

# Mock Data Mode (set to true to use sample data instead of backend APIs)
# Useful for testing when backend is unavailable or incomplete
USE_MOCK_DATA=false

# Display FX for PK market (catalogue GBP → PKR). Unset → never invent a rate.
PKR_PER_GBP=350

# --- Chatbot daily quotas (Option A: count today's history) ---
# Limits hardcoded until Royal Attire GET /chatbot/quotas is live.
CHATBOT_QUOTA_ENFORCE=true
CHATBOT_QUOTA_USE_BACKEND=false
CHATBOT_AI_MESSAGES_PER_DAY=3
CHATBOT_CUSTOM_IMAGES_PER_DAY=2
